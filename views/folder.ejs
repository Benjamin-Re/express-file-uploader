<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Folder</title>
</head>
<body>
    <%- include('navbar') %>  
    <h1><%= locals.folder.name %></h1>
    <p><%= locals.folder.createdAt %></p>
    <a href="/folders/upload/<%= locals.folder.id %>">Upload File</a>
    <ul>
        <% if (locals.folder.files) { %>
            <% for (const file of locals.folder.files) { %>
                <li><a href="/folders/file/<%= file.id %>"><%= file.url %></a></li>
            <% } %>
        <% } %>
    </ul>
</body>
</html>