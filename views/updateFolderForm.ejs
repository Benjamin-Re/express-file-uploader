<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Folder Form</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
</head>

<body>
    <%- include('navbar') %>  
    <form action="/folders/update/<%= locals.folder.id %>" method="POST">
        <label for="folderName">Folder Name: </label>
        <input type="text" name="folderName" id="folderName" value="<%= locals.folder.name %>">
        <button type="submit">Submit</button>
    </form>
</body>

</html>